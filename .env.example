RUNTIME_OS=unix

APP_NAME=Neo
APP_URL=localhost
APP_ENV=local
APP_DEBUG=true
APP_PROFILER=false
APP_KEY=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=app/Database/Database.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

DB_POOL_MIN=1
DB_POOL_MAX=10

SESSION_DRIVER=database
SESSION_TOUCH_INTERVAL=60
SESSION_LAZY=true

CACHE_ENABLED=false
CACHE_STORE=file

FILESYSTEM_DISK=local

SWOOLE_WORKERS=null
SWOOLE_MODE=process
SWOOLE_BACKLOG=2048
SWOOLE_MAX_REQUEST=5000
SWOOLE_MAX_WAIT_TIME=30
SWOOLE_REQUEST_TIMEOUT=30
SWOOLE_TASK_WORKERS=0
SWOOLE_TASK_MAX_REQUEST=1000
